{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Collection for all video game products"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "image": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "card_region": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "enum": [
        "EUROPE",
        "UNITED STATES",
        "GLOBAL",
        "RUSSIA",
        "UNITED KINGDOM",
        "CHINA",
        "ROW (REST OF WORLD)",
        "LATIN AMERICA",
        "ASIA",
        "GERMANY",
        "AUSTRALIA",
        "BRAZIL",
        "INDIA",
        "JAPAN",
        "NORTH AMERICA",
        "POLAND",
        "TURKEY",
        "HONG KONG",
        "TAIWAN",
        "VIETNAM",
        "THAILAND",
        "SOUTH KOREA",
        "ARGENTINA",
        "CANADA",
        "DENMARK",
        "SWEDEN"
      ]
    },
    "price": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "discountPrice": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "notice": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "descriptionkey": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "publisher": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "developer": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "releaseDate": {
      "type": "date",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "minimumRequirement": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "game-requirements.minimum",
      "repeatable": false
    },
    "recommendedRequirement": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "game-requirements.recommended",
      "repeatable": false
    },
    "audio_language": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "game-language.audio-language",
      "repeatable": false
    },
    "interface_language": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "game-language.interface-language",
      "repeatable": false
    },
    "subtitles_language": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "game-language.subtitles-language",
      "repeatable": false
    },
    "game_tag_seo": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "slug-seo-tag.tag",
      "repeatable": false
    },
    "gallery": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "age": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "region": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "enum": [
        "Europe",
        "United states",
        "Global",
        "Russia",
        "United kingdom",
        "China",
        "Row (rest of world)",
        "Latin america",
        "Asia",
        "Germany",
        "Australia",
        "Brazil",
        "India",
        "Japan",
        "North America",
        "Poland",
        "Turkey",
        "Hong Kong",
        "Taiwan",
        "Vietnam",
        "Thailand",
        "South Korea",
        "Argentina",
        "Canada",
        "Denmark",
        "Sweden"
      ]
    },
    "platform": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "enum": [
        "psn",
        "xbox",
        "steam",
        "spotify",
        "roblox",
        "binance"
      ]
    },
    "category": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "enum": [
        "gift-card",
        "game",
        "subscription"
      ]
    },
    "workPlatform": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "enum": [
        "Windows",
        "Steam",
        "Epic Game",
        "Xbox",
        "PlayStation"
      ]
    },
    "item": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "DIGITAL KEY",
      "enum": [
        "DIGITAL KEY"
      ]
    },
    "editiondescription": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Available": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": true
    },
    "relatedProducts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product"
    },
    "var_title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "isBestSeller": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "isGiftCard": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "gameKeys": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::game-key.game-key",
      "mappedBy": "product"
    },
    "stock_stetus": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "enum": [
        "Available",
        "Sold Out"
      ]
    },
    "hideRecomend": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "psn": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "platformIcons": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "platform_image": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "rating": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "relatedRegionProducts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product"
    },
    "stock_alerts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::stock-alert.stock-alert",
      "mappedBy": "product"
    },
    "platform_icon_image": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "type": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "product"
    },
    "seo": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.seo",
      "repeatable": false
    },
    "lowStockAlertSent": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "Tags": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "tags.tag"
      ]
    },
    "item_type": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "enum": [
        "game",
        "software",
        "gift card",
        "game dlc",
        "game points",
        "dlc"
      ]
    }
  }
}
